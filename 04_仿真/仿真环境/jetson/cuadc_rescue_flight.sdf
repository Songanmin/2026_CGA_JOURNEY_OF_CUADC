<?xml version="1.0"?>
    <sdf version="1.9">
      <world name="cuadc_rescue_single">
        <physics name="1ms" type="ignore">
          <max_step_size>0.001</max_step_size>
          <real_time_factor>1.0</real_time_factor>
        </physics>

        <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
        <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
        <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
        <!-- M2 视觉在环（2026-09-12）：加 Sensors 渲染系统让 iris_d435i 的下视
             rgbd 相机出流（/d435i/image 等）。渲染吃 GPU，RTF 会降；纯飞行冒烟
             可临时注释掉本插件恢复满速。注意必须用 DISPLAY=:0 起服务端
             （或 EGL 无头渲染），纯 SSH 无显示环境时相机不出流。 -->
        <!-- 2026-10-08：Sensors 渲染系统临时注释（m3 纯飞行冒烟不需要相机出流；
             本机 nvidia EGL-device 路径坏 → ogre2 传感器渲染初始化绞死世界步进。
             m2 视觉在环跑前恢复本块并用 DISPLAY=:0 桌面会话起服务端） -->

        <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
        <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>

        <scene>
          <!-- ambient 1.0→0.4（2026-09-13）：1.0 时全场亮度被压平（白桶 L157 vs
               场地 L155，视觉无法分割）；0.4 后太阳方向光提供对比度，白桶突出 -->
          <ambient>0.4 0.4 0.4 1</ambient>
          <background>0.78 0.80 0.82</background>

        </scene>

        <spherical_coordinates>
          <latitude_deg>-35.363262</latitude_deg>
          <longitude_deg>149.165237</longitude_deg>
          <elevation>584</elevation>
          <heading_deg>0</heading_deg>
          <surface_model>EARTH_WGS84</surface_model>
        </spherical_coordinates>

        <light type="directional" name="sun">
          <cast_shadows>true</cast_shadows>
          <pose>0 0 20 0 0 0</pose>
          <diffuse>0.9 0.9 0.85 1</diffuse>
          <specular>0.6 0.6 0.6 1</specular>
          <attenuation>
            <range>1000</range>
            <constant>0.9</constant>
            <linear>0.01</linear>
            <quadratic>0.001</quadratic>
          </attenuation>
          <direction>-0.45 0.15 -0.88</direction>
        </light>

        <model name="ground_plane">
          <static>true</static>
          <pose>0 0 -0.01 0 0 0</pose>
          <link name="link">
            <collision name="collision">
              <geometry><plane><normal>0 0 1</normal><size>400 200</size></plane></geometry>
              <surface><friction><ode><mu>1</mu><mu2>1</mu2></ode></friction></surface>
            </collision>
            <visual name="visual">
              <geometry><plane><normal>0 0 1</normal><size>400 200</size></plane></geometry>
              <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
            </visual>
          </link>
        </model>
        <include>
  <name>cuadc_field</name>
  <uri>model://cuadc_field</uri>
  <pose>0 0 0 0 0 0.0</pose>
</include>
<include>
  <name>takeoff_pad</name>
  <uri>model://takeoff_pad</uri>
  <pose>0 0 0.01 0 0 0.0</pose>
</include>
<include>
  <name>drop_1</name>
  <uri>model://drop_bucket_15</uri>
  <pose>29.201 0.878 0 0 0 0.0</pose>
</include>

<include>
  <name>drop_2</name>
  <uri>model://drop_bucket_20</uri>
  <pose>29.333 -2.858 0 0 0 0.0</pose>
</include>

<include>
  <name>drop_3</name>
  <uri>model://drop_bucket_25</uri>
  <pose>31.874 -0.872 0 0 0 0.0</pose>
</include>

<include>
  <name>recon_1</name>
  <uri>model://recon_bucket</uri>
  <pose>55.730 -1.512 0 0 0 0.0</pose>
</include>

<include>
  <name>recon_2</name>
  <uri>model://recon_bucket</uri>
  <pose>56.392 1.241 0 0 0 0.0</pose>
</include>

<include>
  <name>recon_3</name>
  <uri>model://recon_bucket</uri>
  <pose>54.247 -1.603 0 0 0 0.0</pose>
</include>

<include>
  <name>recon_4</name>
  <uri>model://recon_bucket</uri>
  <pose>54.227 -3.163 0 0 0 0.0</pose>
</include>

<include>
  <name>recon_5</name>
  <uri>model://recon_bucket</uri>
  <pose>56.291 -3.384 0 0 0 0.0</pose>
</include>

<model name="hazard_corrosive_recon_1">
  <static>true</static>
  <pose>55.730 -1.512 0.165 0 0 0.789</pose>
  <link name="link">
    <visual name="marker">
      <pose>0 0 0 0 0 0</pose>
      <geometry><box><size>0.12 0.12 0.004</size></box></geometry>
      <material><diffuse>1 1 1 1</diffuse><pbr><metal>
        <albedo_map>model://hazard_marker/materials/textures/corrosive.png</albedo_map>
        <roughness>0.65</roughness><metalness>0</metalness>
      </metal></pbr></material>
    </visual>
  </link>
</model>

<model name="hazard_dangerous_when_wet_recon_3">
  <static>true</static>
  <pose>54.247 -1.603 0.165 0 0 4.193</pose>
  <link name="link">
    <visual name="marker">
      <pose>0 0 0 0 0 0</pose>
      <geometry><box><size>0.12 0.12 0.004</size></box></geometry>
      <material><diffuse>1 1 1 1</diffuse><pbr><metal>
        <albedo_map>model://hazard_marker/materials/textures/dangerous_when_wet.png</albedo_map>
        <roughness>0.65</roughness><metalness>0</metalness>
      </metal></pbr></material>
    </visual>
  </link>
</model>

<model name="hazard_nonflammable_gas_recon_5">
  <static>true</static>
  <pose>56.291 -3.384 0.165 0 0 5.436</pose>
  <link name="link">
    <visual name="marker">
      <pose>0 0 0 0 0 0</pose>
      <geometry><box><size>0.12 0.12 0.004</size></box></geometry>
      <material><diffuse>1 1 1 1</diffuse><pbr><metal>
        <albedo_map>model://hazard_marker/materials/textures/nonflammable_gas.png</albedo_map>
        <roughness>0.65</roughness><metalness>0</metalness>
      </metal></pbr></material>
    </visual>
  </link>
</model>

<!-- yaw=0：机头朝世界 +X（场地前进方向，投放区/侦察区沿 +X），任务节点场地系 x=机头 -->
<include><uri>model://iris_d435i</uri><pose degrees="true">0 0 0.29 0 0 0</pose></include>
      </world>
    </sdf>
