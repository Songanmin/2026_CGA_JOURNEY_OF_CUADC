# 单 CUAV C-RTK 9Ps 换装写入集 2026-10-08：底稿=V3.param（4.7 系当前实态，出处见 changes.md 台账）
# 换装内容：GPS 模块 NEO3 → CUAV C-RTK 9Ps（ZED-F9P 四星多频 + IST8310 罗盘，纯 UART 无 CAN），
#   UART1 → GPS1 座（SERIAL3 串口），完全沿用「单GPS@GPS1串口」现行配方；
#   安装几何：飞控上方 5cm / 左侧 5cm / 与飞控同向放置（10-08 用户更正：同向，非反向 180°）
# 真实增量 4 项（GPS1_POS_X/Y/Z 安装位置补偿 + COMPASS_ORIENT 罗盘朝向），
# 其余为现行配方核心键「点名重写」——本机参数存储有静默回退前科，导入本文件即独立成完整 9Ps GPS 配方
# ⚠️ 枚举序防呆：COMPASS_ORIENT 按底稿枚举（外置 IST8310=instance1）。导入前先读 COMPASS_DEV_ID/DEV_ID2，
#    若外置落在 instance2 则本条改写为 COMPASS_ORIENT2（见 单cuav9ps方案.md §3）
# 导入：python load_params_fast.py <COM口> 参数备份/param_write_cuav9ps_20261008.param（默认两遍+每遍重启，写后等 5 秒再重启）
# 验收：params-diff 实读对账 + check_gps.py 识别 F9P + 六面罗盘校准（ops compass）
#
# ——安装位置补偿（ArduPilot 机体系 FRD：X 前 Y 右 Z 下，单位米；天线相位中心相对飞控）
GPS1_POS_X,0
GPS1_POS_Y,-0.05
GPS1_POS_Z,-0.05
# ——外置罗盘朝向：模块与飞控同向 = 无旋转修正（ROTATION_NONE=0；NEO3 时代的 YAW_90=2 作废）
COMPASS_ORIENT,0
# ——现行配方核心键点名（值不变，防存储漂移）
GPS1_TYPE,1
GPS2_TYPE,0
GPS_AUTO_CONFIG,1
GPS_AUTO_SWITCH,1
GPS1_RATE_MS,200
GPS_PRIMARY,0
SERIAL3_PROTOCOL,5
SERIAL3_BAUD,115
GPS_SAVE_CFG,2
EK3_SRC1_POSXY,3
# 高度源维持气压计=1（2026-10-08 晚借鉴定案，原 3 作废勿回写：hgd 全仓从未动
# EK3_SRC 实战可飞 + Re0 手册 S50「不能仅因'更准'就改 EK3_SRC1_POSZ」；Jetson
# 任务高度体系=RTK−上电基准是机载判读口径，与 FC 闭环源解耦，0.9×/落地判定
# 已有 odom/landed_state 载体修正兜底；待 RTK base 外场 Fixed 复验后再重评）
EK3_SRC1_POSZ,1
EK3_SRC1_VELXY,3
EK3_SRC1_VELZ,3
EK3_SRC1_YAW,1
# ——罗盘承载现行定案：外置主用、板载停用（V3.param 实态，沿用）
COMPASS_USE,1
COMPASS_USE2,0
COMPASS_ENABLE,1
